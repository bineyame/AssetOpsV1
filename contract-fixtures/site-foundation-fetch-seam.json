    "create_site_duplicate_identity": {
      "description": "A Site ID already in use. T006 settled this copy as renderable product copy.",
      "request": {
        "body": {
          "display_name": "Kalangala Mini-Grid",
          "location": {
            "country": "Uganda",
            "locality": "Kalangala"
          },
          "site_id": "MG-002",
          "template_id": "test-archetype",
          "timezone": "Africa/Kampala"
        },
        "method": "POST",
        "path": "/api/simulator-lab/sites"
      },
      "response": {
        "body": {
          "detail": {
            "code": "SITE_ID_IN_USE",
            "message": "Site ID 'MG-002' is already in use. Site IDs are unique across every site store and are compared without regard to case, so the same ID in a different capitalisation is the same site. Nothing was written. Choose a different site ID."
          }
        },
        "status": 409
      }
    },
    "create_site_invalid_request": {
      "description": "A malformed identity. The refusal is product copy the screen renders verbatim, not a validation dump.",
      "request": {
        "body": {
          "display_name": "Kalangala Mini-Grid",
          "location": {
            "country": "Uganda",
            "locality": "Kalangala"
          },
          "site_id": "not a valid id",
          "template_id": "test-archetype",
          "timezone": "Africa/Kampala"
        },
        "method": "POST",
        "path": "/api/simulator-lab/sites"
      },
      "response": {
        "body": {
          "detail": {
            "code": "SITE_REQUEST_INVALID",
            "message": "Site ID 'not a valid id' is not a valid site ID. A site ID is 2 to 64 characters using letters, digits, hyphens, and underscores, starting and ending with a letter or a digit, for example MG-002."
          }
        },
        "status": 422
      }
    },
