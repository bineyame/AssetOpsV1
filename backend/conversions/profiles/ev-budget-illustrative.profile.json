{
  "schema": "assetops.source-profile",
  "schema_version": 1,
  "profile_id": "ev-budget-illustrative",
  "status": "ILLUSTRATIVE",
  "source_type": "budget_workbook",
  "source_system": "ev-budget-workbook",
  "file": {"format": "csv", "encoding": "utf-8", "delimiter": ",", "header_row": 1},
  "values": {"decimal_mark": ".", "thousands_mark": "", "negative": "minus", "date_format": "YYYY-MM-DD", "time_format": "HH:MM", "month_format": "YYYY-MM", "timezone": "Africa/Nairobi"},
  "version": {"from": "constant", "value": "1"},
  "columns": [
    {"header": "Line ID", "paths": [{"path": "source_record_id", "type": "text"}]},
    {"header": "Site", "paths": [{"path": "site_code", "type": "text"}]},
    {"header": "Month", "paths": [{"path": "clocks.recognition_period", "type": "month"}]},
    {"header": "Line", "paths": [{"path": "body.line_ref", "type": "text"}, {"path": "body.factor_id", "type": "text", "map": {"peak_kwh": "peak_kwh", "max_kw": "max_kw", "maintenance": "maintenance", "energy_cost": "energy_cost", "departures_required": "departures_required"}}]},
    {"header": "Value", "paths": [{"path": "body.value", "type": "number"}]},
    {"header": "Currency", "paths": [{"path": "body.currency", "type": "text"}]},
    {"header": "Budget version", "paths": [{"path": "body.version_ref", "type": "text"}]}
  ],
  "constants": {"kind": "BUDGET_LINE"},
  "personal": []
}
