{
  "schema": "assetops.source-profile",
  "schema_version": 1,
  "profile_id": "cold-storage-invoicing-illustrative",
  "status": "ILLUSTRATIVE",
  "source_type": "customer_invoicing",
  "source_system": "cold-storage-invoicing",
  "file": {"format": "csv", "encoding": "utf-8", "delimiter": ",", "header_row": 1},
  "values": {"decimal_mark": ".", "thousands_mark": "", "negative": "minus", "date_format": "YYYY-MM-DD", "time_format": "HH:MM", "month_format": "YYYY-MM", "timezone": "Africa/Nairobi"},
  "version": {"from": "row_digest"},
  "columns": [
    {"header": "Type", "paths": [{"path": "kind", "type": "text", "map": {"Invoice": "CHARGE", "Receipt": "RECEIPT", "Credit note": "ADJUSTMENT"}}]},
    {"header": "Document", "paths": [{"path": "source_record_id", "type": "text"}]},
    {"header": "Site", "paths": [{"path": "site_code", "type": "text"}]},
    {"header": "Party", "paths": [{"path": "subject.kind", "type": "text", "map": {"Customer": "CUSTOMER", "Site": "SITE"}}]},
    {"header": "Party ref", "paths": [{"path": "subject.ref", "type": "text"}]},
    {"header": "Account", "paths": [{"path": "body.account_ref", "type": "text"}]},
    {"header": "Payer", "paths": [{"path": "body.payer_ref", "type": "text"}]},
    {"header": "From", "paths": [{"path": "clocks.effective_from", "type": "date"}]},
    {"header": "To", "paths": [{"path": "clocks.effective_to", "type": "date"}]},
    {"header": "Month", "paths": [{"path": "clocks.recognition_period", "type": "month"}]},
    {"header": "Paid at", "paths": [{"path": "clocks.occurred_at", "type": "datetime"}]},
    {"header": "Line", "paths": [{"path": "body.line_type", "type": "text", "map": {"Storage": "STORAGE"}}]},
    {"header": "Quantity", "paths": [{"path": "quantity.value", "type": "number"}]},
    {"header": "Unit", "paths": [{"path": "quantity.unit", "type": "text", "map": {"crate-day": "crate_day"}}]},
    {"header": "Amount", "paths": [{"path": "amount.value", "type": "number"}]},
    {"header": "Currency", "paths": [{"path": "amount.currency", "type": "text"}]},
    {"header": "Tariff", "paths": [{"path": "body.tariff_code", "type": "text"}]},
    {"header": "Method", "paths": [{"path": "body.method", "type": "text", "map": {"M-Pesa": "MOBILE_MONEY", "Bank": "BANK", "Cash": "CASH"}}]},
    {"header": "State", "paths": [{"path": "status", "type": "text", "map": {"Collected": "COLLECTED", "In transit": "PAID_IN_TRANSIT"}}]},
    {"header": "Reason", "paths": [{"path": "body.reason_code", "type": "text"}]},
    {"header": "Authorised by", "paths": [{"path": "body.authorised_by_ref", "type": "text"}]},
    {"header": "Reference", "paths": [{"path": "body.document_ref", "type": "text"}]}
  ],
  "constants": {},
  "personal": []
}
