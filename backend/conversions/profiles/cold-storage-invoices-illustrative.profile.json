    {"header": "To", "paths": [{"path": "clocks.effective_to", "type": "date"}]},
    {"header": "Month", "paths": [{"path": "clocks.recognition_period", "type": "month"}]},
    {"header": "Crate-days", "paths": [{"path": "quantity.value", "type": "number"}]},
    {"header": "Amount", "paths": [{"path": "amount.value", "type": "number"}]},
    {"header": "Currency", "paths": [{"path": "amount.currency", "type": "text"}]},
    {"header": "Tariff", "paths": [{"path": "body.tariff_code", "type": "text"}]}
