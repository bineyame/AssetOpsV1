# Agent scratch. Tracked text in it (packets, reviews, specs, owner files) is force-added by named path;
# generated evidence never is (tools/checks/tracked_evidence.py, in check-all, fails on it).
.agent/

# Generated evidence lives outside the repo: /opt/assetecon/evidence/<task>/<run>/ (RULES section 9).
# Only the root evidence/ folder: backend/assetops_backend/evidence/ is source code.
/evidence/
**/*-captures/
**/*-captures-*/
**/*-evidence/
**/*-evidence-*/
**/*-recapture/
**/*-screens/
**/*-shots/
*.pid
*.err
*.log
Docs/**/*.html.tmp

# Writable user-authored configuration store. Site documents a user creates
# live here at runtime; they are user data, not shipped configuration, and the
# shipped stores under config/ stay read-only.
var/


# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Pytest temporary directories.
#
# `.pytest-basetemp/` is where `backend/tests/conftest.py` puts them, so that a
# sandboxed agent with write access limited to the workspace can run the suite.
#
# `.pytest-tmp/` is a leftover with broken ACLs that cannot be read or repaired
# without elevation. It is ignored so that it stops interrupting every git
# command with a permission warning; it can be removed from an elevated shell.
.pytest-basetemp*/
.pytest-tmp/
*.egg-info/

# Node / frontend
node_modules/
# VPS worktrees symlink frontend/node_modules to the main checkout: a file, not a directory.
node_modules
dist/
coverage/
# PIPE-1 A10: tsc --incremental cache, kept inside each worktree (node_modules is shared by symlink, so not there).
frontend/.tsbuildinfo/

# Agent session state
.codex/
.demo/
