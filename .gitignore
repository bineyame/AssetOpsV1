.agent/

# Writable user-authored configuration store. Site documents a user creates
# live here at runtime; they are user data, not shipped configuration, and the
# shipped stores under config/ stay read-only.
var/


# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Pytest temporary directories.
#
# `.pytest-basetemp/` is where `backend/tests/conftest.py` puts them, so that a
# sandboxed agent with write access limited to the workspace can run the suite.
#
# `.pytest-tmp/` is a leftover with broken ACLs that cannot be read or repaired
# without elevation. It is ignored so that it stops interrupting every git
# command with a permission warning; it can be removed from an elevated shell.
.pytest-basetemp*/
.pytest-tmp/
*.egg-info/

# Node / frontend
node_modules/
dist/
coverage/

# Agent session state
.codex/
