  "electrical": {
    "battery_address": "battery-state-of-charge@battery",
    "coupling_rules": [
      {
        "rule_id": "controller-view-is-local",
        "display_name": "The controller reads a local view at T",
        "statement": "The controller's view at T is built from its declared local inputs after T's events: the state of charge, the reserve in effect, the irradiance and each load's demand in effect at T. It is never a published reading and is not derived from one, so a reporting cadence, a dropout or a gap changes no controller decision. The view is an immutable record; nothing the controller does can change the world."
      },
      {
        "rule_id": "intent-and-acceptance-are-two-records",
        "display_name": "Intent and acceptance are two records",
        "statement": "The controller emits requests for [T, T+dt) - for example a battery discharge of 30 kW. The resolver accepts what the installation allows - 22 kW through a 22 kW PCS - and records why. Both numbers are kept. Only accepted flows move a stock or reach a later reading; a request never does."
      },
      {
        "rule_id": "resolver-is-a-declared-cascade",
        "display_name": "The resolver is a declared cascade",
        "statement": "PV potential is rated power times irradiance over 1000 W/m2, capped by the inverter. Sources serve load in the Site's source priority, and loads are served in its critical-load priority: a load is served in full before the next one gets anything. The battery discharges no faster than the PCS limit and the request allow and not below the reserve in effect; it charges from PV surplus no faster than the PCS limit and the request allow and not above full. PV nobody can use is curtailed. There is no iterative solver and no tolerance."
      },
      {
        "rule_id": "a-step-splits-where-its-inputs-change",
        "display_name": "A step is evaluated in segments where inputs change",
        "statement": "Where a forcing's window starts or ends inside a step, the resolver evaluates that step as consecutive segments split at those instants, each with the values in effect across it, and the state of charge carried from one segment to the next. No value is applied early, stretched across the step or averaged."
      },
      {
        "rule_id": "energy-balance-is-exact",
        "display_name": "The energy balance is exact",
        "statement": "Every step's accepted flows satisfy their balances exactly in rational arithmetic: PV potential equals PV to load, PV to battery, curtailment and inverter clipping; energy taken into the battery equals energy stored plus charging loss; energy taken out equals energy delivered plus discharging loss; demand equals service plus unserved load, for each load and in total; and the stored-energy change equals what was stored less what was taken out. A balance that does not hold fails the run as BALANCE_IDENTITY_VIOLATION. Nothing is absorbed by a tolerance."
      }
    ],
